{
  "name": "xlsx-to-pdf",
  "version": "0.1.0",
  "description": "Convert Excel (.xlsx) spreadsheets to PDF using WebAssembly in Node.js and browsers",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": {
        "types": "./dist/browser.d.ts",
        "import": "./dist/browser.js"
      },
      "node": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./wasm": "./dist/xlsx_to_pdf_wasm_bg.wasm",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-Apache-2.0"
  ],
  "scripts": {
    "build:wasm": "wasm-pack build wasm --target web --out-dir pkg-wasm --release",
    "build:ts": "tsup",
    "build": "npm run build:ts",
    "build:all": "npm run build:wasm && npm run build:ts",
    "test": "node --test tests/*.test.mjs tests/*.test.cjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ironcalc/IronCalc"
  },
  "keywords": [
    "xlsx",
    "pdf",
    "excel",
    "spreadsheet",
    "convert",
    "xlsx-to-pdf",
    "excel-to-pdf",
    "wasm",
    "webassembly",
    "ironcalc"
  ],
  "author": "IronCalc Contributors",
  "license": "MIT OR Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.10.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
